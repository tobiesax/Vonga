# Transactional email for order confirmations, merchant alerts and status updates.
# Leave blank for local queue mode (events are logged but no email is actually sent).
RESEND_API_KEY=
ORDER_EMAIL_FROM=Vonga <orders@your-verified-domain>
ORDER_EMAIL_REPLY_TO=monitored-owner-mailbox
ORDER_ALERT_EMAIL=confirmed-owner-email
EMAIL_AUTOMATION_ENABLED=true
# Shared secret the scheduled worker (see .github/workflows/process-notifications.yml) presents
# as a Bearer token to POST /api/jobs/process-notifications. Generate a long random value.
NOTIFICATION_WORKER_SECRET=generate-a-private-random-secret

# Supabase production data and merchant authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MERCHANT_SLUG=crunch-and-crumbs

# Merchant dashboard security. Set both values before deployment.
DASHBOARD_PASSWORD=choose-a-strong-password
AUTH_SECRET=generate-a-long-random-secret

# Analytics — leave blank to disable. Only loads after a visitor accepts cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
